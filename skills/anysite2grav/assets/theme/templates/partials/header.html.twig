{% set prefix = grav.language.enabled ? grav.language.getLanguageURLPrefix(lang) : '' %}
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="site-header__logo" href="{{ base_url == '' ? '/' : base_url }}{{ prefix }}" aria-label="{{ site.title }}">
      {% set logo = theme_media(config.theme.logo) %}
      {# Theme SVG logos render inline so currentColor follows the header color. #}
      {% if config.theme.logo starts with 'theme://' and config.theme.logo ends with '.svg' %}{{ svg_image(config.theme.logo, 'site-header__logo-svg')|raw }}
      {% elseif logo %}<img src="{{ logo.url }}" alt="{{ site.title }}">{% else %}{{ site.title }}{% endif %}
    </a>

    <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="sr-only">{{ 'THEME_MENU'|t }}</span><span aria-hidden="true" class="hamburger"></span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="{{ 'THEME_PRIMARY_NAV'|t }}" data-nav>
      <ul class="site-nav__list">
        {% for item in nav.main ?? [] %}
          {% if item.children %}
            <li class="site-nav__item has-children" data-dropdown>
              <div class="site-nav__parent">
                {% if item.url and item.url != '#' %}
                  <a class="site-nav__link {{ item.url == page.url ? 'is-active' }}" href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
                  <button type="button" class="site-nav__link site-nav__disclosure" aria-label="{{ 'THEME_SUBMENU'|t }}: {{ item.label }}" aria-expanded="false" data-dropdown-toggle><span class="chevron" aria-hidden="true"></span></button>
                {% else %}
                  <button type="button" class="site-nav__link" aria-expanded="false" data-dropdown-toggle>{{ item.label }}<span class="chevron" aria-hidden="true"></span></button>
                {% endif %}
              </div>
              <ul class="site-nav__dropdown">
                {% for child in item.children %}
                  <li>
                    <a href="{{ child.url }}" class="site-nav__dropdown-link {{ child.url == page.url ? 'is-active' }}"{% if child.url == page.url %} aria-current="page"{% endif %}>
                      {% set icon = theme_media(child.icon) %}
                      {% if icon %}<img class="site-nav__icon" src="{{ icon.url }}" alt="" width="32" height="32" loading="lazy">{% endif %}
                      <span><strong>{{ child.label }}</strong>{% if child.description %}<small>{{ child.description }}</small>{% endif %}</span>
                    </a>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% else %}
            <li class="site-nav__item"><a class="site-nav__link {{ item.url == page.url ? 'is-active' }}" href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>

      <div class="site-nav__actions">
        {% include 'partials/language-switcher.html.twig' %}
        {% for cta in (nav.ctas ?? [])|filter(cta => not cta.mobile_only) %}
          {% if cta.modal %}
            <button type="button" class="btn {{ loop.last ? 'btn--primary' : 'btn--ghost' }}" data-modal-open="{{ cta.modal }}">{{ cta.label }}</button>
          {% else %}
            <a class="btn {{ loop.last ? 'btn--primary' : 'btn--ghost' }}" href="{{ cta.url }}">{{ cta.label }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </nav>
  </div>
</header>
