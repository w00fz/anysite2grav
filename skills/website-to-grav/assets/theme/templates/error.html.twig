{% extends 'partials/base.html.twig' %}

{% block content %}
  <section class="section">
    <div class="container narrow prose">
      <h1>{{ page.header.title ?: 'Page not found' }}</h1>
      {{ page.content|raw }}
      <p><a class="btn btn--primary" href="{{ base_url == '' ? '/' : base_url }}">{{ site.title }}</a></p>
    </div>
  </section>
{% endblock %}
